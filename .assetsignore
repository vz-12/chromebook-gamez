# Files that are NEVER uploaded as part of the public site. Cloudflare uploads
# everything else in the repo root, so a new image or script added next to
# index.html goes live with no change here. Same format as .gitignore.
#
# Cloudflare refuses any single file over 25 MiB. node_modules is the reason
# this file exists: it holds workerd (128 MiB), which broke the first deploy.

# installed packages and local build/dev leftovers
node_modules
dist
.wrangler

# dotfiles: .git, .github, .gitignore, this file
.*

# the Worker's own source, and the tools around it
src
scripts
package.json
package-lock.json
wrangler.jsonc
wrangler.toml

# notes, not pages. ALL HALLOWS' script and art guide (EVENT-DRAFTS.txt,
# HALLOWS-GUIDE.txt, HALLOWEEN-PLAN.txt) are .txt, and the story must not be
# readable before the event opens.
*.md
*.txt
!robots.txt
CNAME
