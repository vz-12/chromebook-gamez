{
  "name": "voidrunner",
  "version": "1.0.0",
  "private": true,
  "description": "VOIDRUNNER — a single-file neon roguelite arena shooter.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --expose-internals scripts/determinism.mjs",
    "test:lockstep": "node scripts/lockstep.mjs",
    "deploy": "npx wrangler deploy",
    "test:account": "node scripts/account.mjs",
    "test:boards": "node scripts/boards.mjs",
    "test:awards": "node scripts/awards.mjs",
    "test:looks": "node scripts/looks.mjs",
    "test:vault": "node scripts/vault-test.mjs",
    "test:outside": "node scripts/outside.mjs",
    "test:tales": "node scripts/tales.mjs",
    "test:hallows": "node scripts/hallows.mjs",
    "test:live": "node scripts/live.mjs",
    "grant": "node scripts/grant.mjs",
    "supporter": "node scripts/supporter.mjs",
    "vault": "node scripts/vault.mjs",
    "chapter": "node scripts/chapter.mjs",
    "challenge": "node scripts/challenge.mjs",
    "dev:pvp": "node scripts/dev-pvp.mjs",
    "test:pvp": "node scripts/pvp.mjs && node scripts/pvp-engine.mjs",
    "build:pvp": "node scripts/pvp-build.mjs"
  }
}
