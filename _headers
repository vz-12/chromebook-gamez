# Response headers for the static files. Cloudflare reads this file from the
# assets folder (the repo root); it is not served as a page. The /api/* responses
# set their own headers in src/.
#
# No Content-Security-Policy and no cross-origin isolation, deliberately.
# Fireproof is loaded as an ES module from https://esm.sh at runtime; a
# restrictive script-src or COEP policy would block it and silently drop the
# game back to localStorage saves. If you add a CSP later, it must allow:
#   script-src  'self' 'unsafe-inline' https://esm.sh
#   connect-src 'self' https://esm.sh

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Always revalidate the game itself so players pick up new builds immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The leaderboard page (leaderboard/) is as current as the game.
/leaderboard/*
  Cache-Control: public, max-age=0, must-revalidate
